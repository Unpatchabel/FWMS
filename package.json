{
  "name": "fwms",
  "productName": "FWMS",
  "author": "Unpatchabel",
  "main": "desktop/main.cjs",
  "version": "0.1.0",
  "private": true,
  "description": "Family Wealth Management System — a private, self-hosted family financial dashboard.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "setup": "node scripts/migrate.cjs",
    "desktop:package": "npm run build && node desktop/prepare.cjs && electron-builder --config desktop/builder.yml",
    "desktop:smoke": "npm run build && node desktop/smoke.cjs",
    "typecheck": "tsc --noEmit",
    "desktop:check": "node --check desktop/main.cjs && node --check desktop/bootstrap.cjs && node --check desktop/security.cjs && node --check desktop/preload.cjs",
    "db:check": "node --import tsx scripts/check-ledger.ts",
    "test:http": "node scripts/http-smoke.cjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "jose": "5.9.3",
    "lucide-react": "0.441.0",
    "next": "15.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "2.15.4",
    "tailwind-merge": "2.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "electron": "44.11.5",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.23",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.13",
    "tsx": "4.23.9",
    "typescript": "5.6.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
