# ---- FWMS environment ----
# Copy this file to ".env" and fill in real values.

# SQLite database file location (kept inside /prisma so backups are one file copy).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. MUST be long and random.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Used only to create the first OWNER when running npm run setup on a fresh database.
FWMS_OWNER_EMAIL=""
FWMS_OWNER_PASSWORD=""

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE="604800"

# Optional HTTPS origin when running behind Tailscale Serve.
# Set to this device's exact https://...ts.net URL (without a trailing slash).
FWMS_PUBLIC_ORIGIN=""
